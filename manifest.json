{
  "manifest_version": 3,
  "name": "Excalidraw Vault & Auto-Save",
  "version": "1.0.0",
  "description": "Automatically backs up Excalidraw drawings in the background. Provides a sidebar library to browse, search, and restore sketches.",
  "permissions": [
    "storage",
    "unlimitedStorage"
  ],
  "host_permissions": [
    "https://excalidraw.com/*"
  ],
  "action": {
    "default_icon": {
      "16": "assets/favicon-16x16.png",
      "32": "assets/favicon-32x32.png",
      "48": "assets/android-chrome-192x192.png",
      "128": "assets/android-chrome-192x192.png"
    },
    "default_title": "Excalidraw Vault"
  },
  "icons": {
    "16": "assets/favicon-16x16.png",
    "32": "assets/favicon-32x32.png",
    "48": "assets/android-chrome-192x192.png",
    "128": "assets/android-chrome-192x192.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://excalidraw.com/*"],
      "js": [
        "src/state.js",
        "src/utils.js",
        "src/storage.js",
        "src/ui.js",
        "src/main.js"
      ],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ]
}
